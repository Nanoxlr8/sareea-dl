{
  "name": "sareea-dl",
  "productName": "Sareea DL",
  "version": "0.1.0",
  "description": "Sareea DL - a fast, segmented, resumable download manager (engine, CLI, Electron desktop app, browser extension).",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000 \"test/*.test.ts\"",
    "dl": "node src/cli.ts",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "package": "node scripts/package.mjs",
    "build:host": "node scripts/build-host.mjs",
    "e2e:extension": "node scripts/e2e-extension.mjs",
    "extension:key": "node scripts/make-extension-key.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.1",
    "esbuild": "^0.28.2"
  }
}
